# Copy this file to .env, then paste your OpenAlex key after the equals sign.
# Never commit, upload, screenshot, or share your completed .env file.
OPENALEX_API_KEY=

# Optional: increase the delay between requests if OpenAlex asks you to slow down.
OPENALEX_CALIBRATION_DELAY_MS=150

# Phase E6B: optional contact email for Crossref's REST API "polite pool"
# (better, more consistent rate limits — no API key exists or is required
# for Crossref's public/polite access). lib/discovery-crossref-provider.ts
# never reads this itself; a caller reads it and passes it in as
# CrossrefProviderConfig.contactEmail, the same separation
# lib/openalex-check.ts already uses for OPENALEX_MAILTO above.
CROSSREF_MAILTO=

# Database safety: do NOT set TURSO_DATABASE_URL / TURSO_AUTH_TOKEN in
# .env.local (or any file next dev/next build/next start loads). When those
# two are unset, lib/reports-db.ts and app/api/ingest/route.ts automatically
# fall back to a local SQLite file (data/reports-dev.db, data/turnitplus.db)
# instead of a shared remote database. If you have credentials for a shared
# Turso instance, keep them under different names (this repo's convention:
# DEV_TURSO_DATABASE_URL / DEV_TURSO_AUTH_TOKEN in .env.local,
# PROD_TURSO_DATABASE_URL / PROD_TURSO_TOKEN in .env.production.local) and
# only use them as TURSO_DATABASE_URL / TURSO_AUTH_TOKEN for one deliberate
# command at a time, never left active as the real names. The real
# production database is configured directly in the Vercel dashboard/CLI,
# scoped to Production only, and is never mirrored in any local file.
# tests/database-isolation.test.mjs enforces this for every test file, and
# separately checks that .env.local (if present) never sets the real names.

# Developer/admin dashboard: the ONE account that should ever get the
# developer/admin role (see lib/admin-role.ts). Set this to your own account's
# email, in .env.local for local dev and as a Production environment variable
# in the Vercel project dashboard for production — never commit a real value
# here. Promotion happens automatically the next time that address logs in or
# signs up; nothing else needs to be configured. Leave unset to disable
# developer/admin access entirely.
ADMIN_EMAIL=

# Corpus-admission release: shared bearer secret Vercel Cron uses to call the
# two internal sweep routes (see vercel.json's "crons" entries and
# app/api/internal/corpus-admission-sweep, .../corpus-admission-promotion-sweep).
# Vercel automatically sends this as `Authorization: Bearer <value>` when the
# same-named Production environment variable is set. Leave unset to fail
# closed: both routes 404 every request, cron or otherwise, rather than
# ever treating an unconfigured secret as "open to anyone."
CRON_SECRET=

# Corpus-admission release: three independent feature flags gating the
# corpus-admission pipeline. Each must be the exact string "true" to enable —
# unset, empty, or any other value is OFF. Intended rollout order: enable
# CORPUS_ADMISSION_ENABLED first (gate candidates into the review queue),
# then CORPUS_PROMOTION_ENABLED (index accepted candidates into the shared
# corpus), then CORPUS_SOURCE_MATCHING_ENABLED (surface corpus-sourced
# matches on report views). See lib/corpus-admission-report-integration.ts,
# lib/corpus-admission-promotion.ts, and lib/corpus-source-matching-flag.ts.
CORPUS_ADMISSION_ENABLED=
CORPUS_PROMOTION_ENABLED=
CORPUS_SOURCE_MATCHING_ENABLED=

# Corpus-admission release: comma-separated allowlist of exact account ids
# (never emails) permitted to see the corresponding experimental surface.
# Unset or empty means the allowlist is empty, which means nobody — the
# default-off state and the production rollback switch at once (clearing the
# variable disables the surface for everyone, no code/matcher/database
# change). See lib/e8p-visibility.ts.
E8P_VISIBILITY_ALLOWLIST=
