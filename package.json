{
  "name": "turnitin-plus-report",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs",
    "validate:corpus": "node --import tsx tools/validate-corpus.ts && npm run validate:positive-benchmark",
    "validate:positive-benchmark": "node --import tsx tools/validate-external-ai-benchmark.ts && npm run validate:generator-benchmark",
    "validate:generator-benchmark": "node --import tsx tools/validate-generator-diversity-benchmark.ts",
    "import:generator-benchmark": "node --import tsx tools/import-generator-diversity-benchmark.ts",
    "import:turnitin-reports": "python3 tools/import-turnitin-reports.py",
    "import:similarity-regression": "node --import tsx tools/import-similarity-regression.ts",
    "evaluate:similarity-regression": "node --import tsx tools/evaluate-similarity-regression.ts",
    "assign:evaluation-split": "node --import tsx tools/similarity-evaluation-protocol.ts",
    "import:similarity-final-test": "node --import tsx tools/import-similarity-final-test.ts",
    "append:similarity-final-test": "node --import tsx tools/append-similarity-final-test.ts",
    "evaluate:similarity-final-test": "node --import tsx tools/evaluate-similarity-final-test.ts",
    "diagnose:similarity-source-floor": "node --import tsx tools/diagnose-similarity-source-floor.ts",
    "evaluate:similarity-multifeature": "node --import tsx tools/evaluate-similarity-multifeature.ts",
    "score:positive-benchmark": "node --import tsx tools/score-external-ai-positives.ts",
    "detect:duplicates": "node --import tsx tools/detect-duplicates.ts",
    "sweep:similarity": "npm run validate:corpus && npm run detect:duplicates && node --import tsx tools/sweep-similarity-parameters.ts",
    "build:index": "npm run validate:corpus && node --import tsx tools/build-index.ts && npm run detect:duplicates",
    "calibrate:similarity": "npm run sweep:similarity && node --import tsx tools/calibrate-similarity.ts",
    "collect:wikipedia-calibration": "node --import tsx tools/calibrate-wikipedia-signal.ts",
    "collect:openalex-calibration": "node --env-file-if-exists=.env --import tsx tools/calibrate-openalex-signal.ts",
    "calibrate:ai": "npm run validate:corpus && npm run check:ai-model && node --import tsx tools/measure-ai-fpr.ts",
    "reextract:ai-negatives": "node --import tsx tools/reextract-ai-negatives-pdfjs.ts",
    "check:ai-model": "node --import tsx tools/check-ai-model-contract.ts",
    "summarize:ai-benchmark": "npm run validate:corpus && node --import tsx tools/summarize-ai-benchmark.ts",
    "split:ai-benchmark-dates": "node --import tsx tools/split-ai-benchmark-by-date.ts",
    "benchmark:ai-model": "npm run validate:corpus && node --import tsx tools/measure-ai-benchmark.ts",
    "import:english-reference": "python3 tools/import-english-reference.py",
    "evaluate:ai": "npm run validate:corpus && npm run check:ai-model && node --import tsx tools/evaluate-ai-detector.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.9",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Turnitin Plus Report"
}
